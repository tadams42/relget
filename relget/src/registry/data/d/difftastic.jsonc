{
  "id": "difftastic",
  "category_id": "git",
  "description": "Structural diff tool that understands code syntax",
  "url": "https://github.com/Wilfred/difftastic",
  "binaries": [
    {
      "id": 1,
      "name": "difft",
      "version_cmdline": "--version",
      "is_main": true
    }
  ],
  "assets": [
    {
      "id": 1,
      "type": "archive",
      // Since 0.71.0 the asset name carries the version (`difft-0.71.0-x86_64-...`).
      "starts_with": "difft-",
      "ends_with": "-x86_64-unknown-linux-musl.tar.gz"
    }
  ],
  "shell_completions": [],
  "man_pages": []
}
